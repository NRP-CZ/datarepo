.ui.cards {
  &.frontpage-cards {
    margin-top: 0;

    .card {
      display: flex;
      flex-direction: column;
      // tried debugging but the gap property just wont work when ui cards is the container
      margin-left: 3.75rem;
      margin-right: 3.75rem;
      .content {
        display: flex;
        flex-direction: column;
        flex: 1;

        .header {
          font-weight: 500;
          color: @black;
          margin-bottom: 0;
        }

        .description {
          color: @darkGrey;
          margin-top: auto;
        }

        .card-icon {
          margin-bottom: 1rem;

          i.icon {
            color: @greys3;
          }
        }

        .ui.button {
          align-self: center;
        }
      }
    }
  }
}
.ui.card.borderless.facet {
  background-color: transparent;
  h3 {
    font-size: 1.2rem;
  }

  // Foldable facet cards carry a hardcoded `rel-ml-1` class in their JSX,
  // which the "Verze" versions toggle card does not have. That utility class
  // is generated by invenio_theme's `.generate-relative-margins` with
  // `margin-left: 1em !important` (~16px), indenting every foldable facet
  // relative to the toggle. The `!important` there can only be beaten by
  // another `!important`, so we reset the indent here.
  &.foldable {
    margin-left: 0 !important;
  }
}
