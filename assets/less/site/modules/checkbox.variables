// Design variables
@checkboxBackgroundColor: @white;
@checkboxBorderColor: @greys2;
@checkboxBackgroundHoverColor: @greys1;

@toggleCheckboxBorderHoverColor: @pinks1;
@toggleCheckboxBackgroundPressedColor: @greys1;

// Semantic UI variables
@checkboxBackground: @checkboxBackgroundColor;
@checkboxBorder: 1px solid @checkboxBorderColor;
@checkboxHoverBackground: @checkboxBackgroundHoverColor;

@toggleFocusColor: @greys2;
@toggleHoverColor: @greys3;
@toggleLaneBackground: @greys2;
@toggleOnLaneColor: @primaryColor;
@toggleOnFocusLaneColor: @mainColors6;
