{% extends "page.html" %}

{% block css %}
  {{ super() }}
  <style>
    .get-access-panel {
      height: 100%;
    }
  </style>
{% endblock css %}

{% block javascript %}
  {{ super() }}
  {{ webpack['get_access.js'] }}
{% endblock javascript %}

{% block page_body %}
  <div class="ui main container rel-mt-3 rel-mb-3">
    <h1>{{ _("Getting Permission to Deposit Datasets") }}</h1>

    <p>
      {{ _("Your account does not have deposit permission yet, so you cannot upload datasets.
      Deposition is open primarily to employees and students of eligible academic and research
      institutions in the Czech Republic, their international collaborators, and other approved
      users whose intended use is consistent with the mission of the repository.") }}
    </p>
    <p>{{ _("You can obtain deposit permission in one of two ways:") }}</p>

    <div class="ui two column stackable equal height grid rel-mt-2">
      <div class="column">
        <div class="ui raised segment get-access-panel">
          <h2 class="ui header">
            {{ _("Through a community") }}
            <span class="ui small primary label">{{ _("Recommended") }}</span>
          </h2>
          <p>
            {{ _("Depositing through a community is the recommended way — your data gets a curator
            and a home next to related datasets.") }}
          </p>

          <h3 class="ui dividing header">{{ _("Open membership communities") }}</h3>

          <a class="ui primary fluid right labeled icon button rel-mb-2"
             href="{{ url_for('invenio_communities.communities_search') }}">
            {{ _("Find a community") }}
            <i class="search icon"></i>
          </a>

          <h4 class="ui header">{{ _("Once you are on the community page:") }}</h4>
          <ol class="ui list">
            <li>{{ _("Click the \"Request Membership\" button") }}</li>
            <li>{{ _("Fill in the form, stating the reason for joining") }}</li>
            <li>
              {{ _("You will receive an email once your membership is approved; you can track the request") }}
              <a href="{{ url_for('invenio_app_rdm_users.requests') }}">{{ _("on your Dashboard under Requests") }}</a>.
            </li>
          </ol>

          <div class="ui hidden divider"></div>

          <h3 class="ui dividing header">{{ _("Closed membership communities") }}</h3>
          <p>
            {{ _("These communities do not accept online applications — contact the community
            manager directly. You can find a contact on the community's About page, or write to
            us at:") }}
          </p>
          <a class="ui basic compact labeled icon button" href="mailto:datarepo@eosc.cz">
            <i class="envelope outline icon"></i>
            datarepo@eosc.cz
          </a>
        </div>
      </div>

      <div class="column">
        <div class="ui secondary segment get-access-panel rel-p-1">
          <h2 class="ui header">{{ _("As an individual depositor") }}</h2>
          <p>
            {{ _("If no suitable community exists for your data, you can deposit directly
            as an individual depositor.") }}
          </p>

          <div id="standalone_submitter_application" aria-busy="true">
            <button class="ui secondary disabled button">{{ _("Loading application form…") }}</button>
          </div>

          <p class="rel-mt-2"><b>{{ _("How it works:") }}</b></p>
          <ol class="ui list">
            <li>
              {{ _("Submit the application form. You may be asked to describe your intended
              use of the repository.") }}
            </li>
            <li>
              {{ _("Wait for review. Applications are evaluated manually, so approval may not
              be immediate — you will receive an email once your application has been processed.") }}
            </li>
            <li>
              {{ _("Once approved, sign out and sign in again so the new permission
              is picked up — then you can deposit your first dataset.") }}
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
